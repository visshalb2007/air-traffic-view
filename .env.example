# OpenSky Network REST API Credentials (Optional - anonymous access available)
# When provided, credentials are used server-side only in Next.js route handlers
OPENSKY_CLIENT_ID=your_client_id_here
OPENSKY_CLIENT_SECRET=your_client_secret_here

# OpenSky API Base URL
OPENSKY_BASE_URL=https://opensky-network.org/api

# In-memory caching TTL (seconds) to respect OpenSky rate limits
CACHE_TTL_SECONDS=10

# Default Airspace Region (europe, us_east, us_west, india, east_asia, middle_east)
DEFAULT_REGION=europe
